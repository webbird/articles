{#
    articles/twig/modify_article.twig – add or edit one article
#}
<div class="mod_articles art-backend" data-art-section="{{ section_id }}">
    <p class="art-back"><a href="{{ url_list }}">← {{ t('BACK_TO_LIST') }}</a></p>
    <h2>{{ exists ? t('EDIT_ARTICLE') : t('ADD_ARTICLE') }}</h2>
    {% include '_messages.twig' %}

    <form class="art-form art-editor" action="{{ action }}" method="post" enctype="multipart/form-data">
        {% include '_hidden.twig' %}
        <input type="hidden" name="art_action" value="article_save">
        <input type="hidden" name="article_id" value="{{ form.article_id }}">
        {# Enter in a text field presses the first submit button; that must be "save", not a gallery arrow #}
        <button type="submit" class="art-sr" tabindex="-1" aria-hidden="true">{{ t('SAVE') }}</button>

        <div class="art-editor-grid">
            <div class="art-editor-main">
                <label class="art-field">{{ t('TITLE') }}
                    <input type="text" name="title" value="{{ form.title }}" required maxlength="255" data-art-title>
                </label>
                <div class="art-field">
                    <label for="art-slug-{{ section_id }}">{{ t('SLUG') }}</label>
                    <div class="art-slug">
                        <span class="art-muted">{{ link_prefix }}</span>
                        <input type="text" id="art-slug-{{ section_id }}" name="slug" value="{{ form.slug }}" maxlength="200"
                               {% if form.slug_locked %}readonly{% endif %} data-art-slug aria-describedby="art-slug-hint-{{ section_id }}">
                        <span class="art-muted">{{ link_suffix }}</span>
                        <button type="button" class="art-button" data-art-slug-toggle aria-pressed="{{ form.slug_locked ? 'false' : 'true' }}">{{ t('SLUG_EDIT') }}</button>
                        <input type="hidden" name="slug_locked" value="{{ form.slug_locked ? 1 : 0 }}" data-art-slug-locked>
                    </div>
                    <small id="art-slug-hint-{{ section_id }}" class="art-muted">{{ t('SLUG_HINT') }}</small>
                </div>
                <div class="art-field"><span class="art-label">{{ t('TEASER') }}</span>{{ editor_teaser|raw }}</div>
                <div class="art-field"><span class="art-label">{{ t('CONTENT') }}</span>{{ editor_content|raw }}</div>
                {% if use_block2 %}
                    <div class="art-field"><span class="art-label">{{ t('BLOCK2') }}</span>{{ editor_block2|raw }}
                        <small class="art-muted">{{ t('BLOCK2_HINT') }}</small></div>
                {% endif %}
            </div>

            <div class="art-editor-side">
                <fieldset class="art-card">
                    <legend>{{ t('PUBLISHING') }}</legend>
                    <label><input type="checkbox" name="active" value="1"{% if form.active %} checked{% endif %}> {{ t('ACTIVE') }}</label>
                    <label class="art-field">{{ t('PUBLISHED_FROM') }} <input type="datetime-local" name="published_from" value="{{ form.published_from }}"></label>
                    <label class="art-field">{{ t('PUBLISHED_UNTIL') }} <input type="datetime-local" name="published_until" value="{{ form.published_until }}"></label>
                    <small class="art-muted">{{ t('PERIOD_HINT') }}</small>
                </fieldset>

                <fieldset class="art-card">
                    <legend>{{ t('PLACEMENT') }}</legend>
                    <label class="art-field">{{ t('SECTION_AND_GROUP') }}
                        <select name="place">
                            {% for place in places %}
                                <optgroup label="{{ place.label }}">
                                    {% for o in place.options %}<option value="{{ o.value }}"{% if o.value == form.place %} selected{% endif %}>{{ o.label }}</option>{% endfor %}
                                </optgroup>
                            {% endfor %}
                        </select>
                    </label>
                    <fieldset class="art-taglist">
                        <legend>{{ t('TAGS') }}</legend>
                        {% for tag in tags %}
                            <label><input type="checkbox" name="tags[]" value="{{ tag.id }}"{% if tag.id in form.tags %} checked{% endif %}> <span class="art-tag"{{ tag.style|raw }}>{{ tag.title }}</span></label>
                        {% else %}
                            <span class="art-muted">{{ t('NO_TAGS') }}</span>
                        {% endfor %}
                    </fieldset>
                    <small class="art-muted">{{ t('PLACEMENT_HINT') }}</small>
                </fieldset>

                <fieldset class="art-card">
                    <legend>{{ t('PREVIEW_IMAGE') }}</legend>
                    {% include '_image.twig' with {image: preview, field: 'image', remove: 'image_remove'} %}
                </fieldset>
            </div>
        </div>

        <fieldset class="art-card art-gallery-box">
            <legend>{{ t('GALLERY') }} <span class="art-muted">· {{ t('IMAGE_COUNT', images|length) }}</span></legend>
            <ol class="art-gallery" data-art-gallery>
                {% for image in images %}
                    <li class="art-gallery-item">
                        <input type="hidden" name="image_order[]" value="{{ image.id }}">
                        <span class="art-grip" aria-hidden="true">⋮⋮</span>
                        {% if image.url %}<img src="{{ image.url }}" alt="">{% else %}<span class="art-thumb-missing">{{ image.file }}</span>{% endif %}
                        <label class="art-caption"><span class="art-sr">{{ t('CAPTION') }}: {{ image.file }}</span>
                            <input type="text" name="caption[{{ image.id }}]" value="{{ image.caption }}" maxlength="255" placeholder="{{ t('CAPTION') }}"></label>
                        <span class="art-order">
                            {% if not loop.first %}<button type="submit" name="image_move" value="{{ image.id }}:up" class="art-icon" title="{{ t('MOVE_UP') }}">▲<span class="art-sr">{{ t('MOVE_UP') }}: {{ image.file }}</span></button>{% endif %}
                            {% if not loop.last %}<button type="submit" name="image_move" value="{{ image.id }}:down" class="art-icon" title="{{ t('MOVE_DOWN') }}">▼<span class="art-sr">{{ t('MOVE_DOWN') }}: {{ image.file }}</span></button>{% endif %}
                        </span>
                        <label class="art-danger"><input type="checkbox" name="image_delete[]" value="{{ image.id }}"> {{ t('DELETE') }}<span class="art-sr">: {{ image.file }}</span></label>
                    </li>
                {% endfor %}
            </ol>
            {# A new article has no folder yet; many files in one POST could also exceed post_max_size and lose the text #}
            {% if exists %}
            <div class="art-dropzone" data-art-uploader data-max="{{ max_upload }}"
                 data-msg-size="{{ t('ERR_IMAGE_SIZE') }}" data-msg-type="{{ t('ERR_IMAGE_TYPE') }}" data-msg-failed="{{ t('ERR_IMAGE_UPLOAD') }}" data-msg-done="{{ t('UPLOAD_DONE') }}" data-msg-busy="{{ t('CONFIRM_UPLOAD_BUSY') }}">
                <label>{{ t('GALLERY_ADD') }}
                    <input type="file" name="gallery[]" multiple accept=".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif,image/webp">
                </label>
                <small class="art-muted">{{ t('UPLOAD_HINT', max_upload_mb) }} {{ t('GALLERY_HINT') }}</small>
                <ul class="art-uploads" data-art-uploads aria-live="polite"></ul>
            </div>
            {% else %}
            <p class="art-muted">{{ t('GALLERY_HINT_NEW') }}</p>
            {% endif %}
            <template data-art-gallery-row>
                <li class="art-gallery-item">
                    <input type="hidden" name="image_order[]" value="">
                    <span class="art-grip" aria-hidden="true">⋮⋮</span>
                    <img src="" alt="">
                    <label class="art-caption"><span class="art-sr">{{ t('CAPTION') }}</span>
                        <input type="text" name="" value="" maxlength="255" placeholder="{{ t('CAPTION') }}"></label>
                    <span class="art-order"></span>
                    <label class="art-danger"><input type="checkbox" name="image_delete[]" value=""> {{ t('DELETE') }}</label>
                </li>
            </template>
        </fieldset>

        <div class="art-buttons">
            <button type="submit" class="art-button art-button--primary">{{ t('SAVE') }}</button>
            <button type="submit" class="art-button" name="save_back" value="1">{{ t('SAVE_BACK') }}</button>
            {% if url_view %}<a class="art-button" href="{{ url_view }}" target="_blank" rel="noopener">{{ t('VIEW') }}</a>{% endif %}
            <a class="art-button" href="{{ url_list }}">{{ t('CANCEL') }}</a>
        </div>
    </form>
</div>
